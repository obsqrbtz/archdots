/* Generated by clrsync */

* {
    bg:       {background.hex};
    surface:  {surface.hex};
    surface2: {surface_variant.hex};
    surface3: {surface_container.hex};

    fg:       {foreground.hex};
    muted:    {editor_comment.hex};

    accent:   {accent.hex};
    accent2:  {accent_secondary.hex};
    on-accent: {background.hex};

    line:     {border.hex};
    line-focused: {border_focused.hex};

    error:    {error.hex};
    warning:  {warning.hex};
    success:  {success.hex};

    selected-bg: {accent.hex};
    selected-fg: {background.hex};
    urgent-bg:   {error.hex};
    urgent-fg:   {on_error.hex};
    active-bg:   {surface_container.hex};
    active-fg:   {accent.hex};
}
