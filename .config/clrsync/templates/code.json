{
  "name": "clrsync",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "namespace": "{editor_namespace}",
    "class": "{editor_class}",
    "interface": "{editor_interface}",
    "enum": "{editor_enum}",
    "enumMember": "{editor_constant}",
    "struct": "{editor_class}",
    "type": "{editor_type}",
    "typeParameter": "{editor_type}",
    "parameter": "{editor_parameter}",
    "variable": "{editor_variable}",
    "variable.readonly": "{editor_constant}",
    "variable.defaultLibrary": "{editor_constant}",
    "property": "{editor_property}",
    "property.readonly": "{editor_constant}",
    "function": "{editor_function}",
    "function.defaultLibrary": "{editor_function}",
    "method": "{editor_function}",
    "macro": "{editor_decorator}",
    "decorator": "{editor_decorator}",
    "event": "{editor_function}",
    "label": "{editor_keyword}",
    "keyword": "{editor_keyword}",
    "operator": "{editor_operator}",
    "number": "{editor_number}",
    "string": "{editor_string}",
    "regexp": "{editor_regex}",
    "comment": "{editor_comment}",
    "*.deprecated": {
      "strikethrough": true
    }
  },
  "tokenColors": [
    {
      "name": "Default text",
      "scope": [
        "source",
        "meta.embedded",
        "meta.template.expression",
        "text"
      ],
      "settings": {
        "foreground": "{editor_foreground}"
      }
    },
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "{editor_comment}"
      }
    },
    {
      "name": "Comment keywords (TODO, FIXME)",
      "scope": [
        "keyword.codetag",
        "storage.type.class.doxygen",
        "storage.type.class.jsdoc",
        "storage.type.class.phpdoc"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "{editor_decorator}"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.definition.list",
        "punctuation.definition.block",
        "punctuation.definition.bracket",
        "meta.brace",
        "meta.delimiter"
      ],
      "settings": {
        "foreground": "{editor_punctuation}"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.assignment",
        "keyword.operator.bitwise",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.relational",
        "keyword.operator.increment",
        "keyword.operator.decrement",
        "keyword.operator.ternary",
        "keyword.operator.spread",
        "keyword.operator.sigil",
        "keyword.operator.channel",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "{editor_operator}"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.other",
        "keyword.package",
        "storage",
        "storage.modifier",
        "storage.type.function",
        "storage.type.class",
        "storage.type.namespace",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.expression",
        "keyword.operator.module"
      ],
      "settings": {
        "foreground": "{editor_keyword}"
      }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": [
        "variable.language",
        "variable.language.this",
        "variable.language.super",
        "variable.parameter.function.language.special",
        "support.variable.magic.python",
        "constant.language.null",
        "constant.language.undefined"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "{editor_keyword}"
      }
    },
    {
      "name": "Storage types",
      "scope": [
        "storage.type",
        "storage.type.primitive",
        "storage.type.built-in",
        "support.type",
        "support.type.primitive",
        "support.type.builtin",
        "entity.name.type",
        "meta.type.annotation",
        "meta.return-type"
      ],
      "settings": {
        "foreground": "{editor_type}"
      }
    },
    {
      "name": "Classes",
      "scope": [
        "entity.name.type.class",
        "entity.name.class",
        "support.class",
        "entity.other.inherited-class",
        "meta.definition.class"
      ],
      "settings": {
        "foreground": "{editor_class}"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface",
        "entity.name.interface",
        "meta.interface"
      ],
      "settings": {
        "foreground": "{editor_interface}"
      }
    },
    {
      "name": "Enums",
      "scope": [
        "entity.name.type.enum",
        "entity.name.enum"
      ],
      "settings": {
        "foreground": "{editor_enum}"
      }
    },
    {
      "name": "Namespaces / modules",
      "scope": [
        "entity.name.namespace",
        "entity.name.type.namespace",
        "entity.name.type.module",
        "entity.name.module",
        "entity.name.package",
        "entity.name.scope-resolution",
        "support.module",
        "support.other.namespace",
        "storage.modifier.import",
        "storage.modifier.package"
      ],
      "settings": {
        "foreground": "{editor_namespace}"
      }
    },
    {
      "name": "Functions and methods",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function-call",
        "meta.function-call.generic",
        "support.function",
        "support.function.any-method",
        "variable.function",
        "meta.require",
        "entity.name.function.member"
      ],
      "settings": {
        "foreground": "{editor_function}"
      }
    },
    {
      "name": "Decorators / annotations / macros",
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "meta.function.decorator",
        "support.token.decorator",
        "storage.type.annotation",
        "entity.name.function.preprocessor",
        "meta.preprocessor",
        "keyword.control.directive"
      ],
      "settings": {
        "foreground": "{editor_decorator}"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "variable.other.readwrite",
        "variable.other.object",
        "meta.definition.variable.name",
        "support.variable"
      ],
      "settings": {
        "foreground": "{editor_variable}"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "variable.parameter.function",
        "meta.parameters",
        "variable.other.generic-type",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "{editor_parameter}"
      }
    },
    {
      "name": "Properties and object keys",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "entity.name.variable.field",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "{editor_property}"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant",
        "constant.other",
        "constant.character",
        "constant.language",
        "support.constant",
        "variable.other.constant",
        "variable.other.enummember",
        "punctuation.definition.constant"
      ],
      "settings": {
        "foreground": "{editor_constant}"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.hex",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "{editor_number}"
      }
    },
    {
      "name": "Booleans",
      "scope": [
        "constant.language.boolean",
        "constant.language.true",
        "constant.language.false",
        "constant.language.json"
      ],
      "settings": {
        "foreground": "{editor_boolean}"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "string.unquoted",
        "punctuation.definition.string",
        "keyword.other.template",
        "keyword.other.substitution",
        "source.ini"
      ],
      "settings": {
        "foreground": "{editor_string}"
      }
    },
    {
      "name": "String interpolation",
      "scope": [
        "punctuation.definition.template-expression",
        "punctuation.section.embedded",
        "variable.interpolation",
        "punctuation.quasi.element"
      ],
      "settings": {
        "foreground": "{editor_operator}"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "constant.other.character-class.regexp",
        "constant.character.character-class.regexp",
        "keyword.operator.quantifier.regexp",
        "keyword.control.anchor.regexp",
        "punctuation.definition.group.regexp",
        "keyword.operator.regexp"
      ],
      "settings": {
        "foreground": "{editor_regex}"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape",
        "constant.character.entity",
        "constant.character.format.placeholder",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "{editor_escape_character}"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "entity.name.tag.html",
        "entity.name.tag.yaml",
        "meta.tag",
        "support.class.component"
      ],
      "settings": {
        "foreground": "{editor_tag}"
      }
    },
    {
      "name": "Tag punctuation",
      "scope": [
        "punctuation.definition.tag",
        "punctuation.definition.tag.begin",
        "punctuation.definition.tag.end"
      ],
      "settings": {
        "foreground": "{editor_punctuation}"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "entity.other.attribute-name.class",
        "entity.other.attribute-name.pseudo-class",
        "entity.other.attribute-name.pseudo-element",
        "meta.attribute"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "{editor_attribute}"
      }
    },
    {
      "name": "CSS ids",
      "scope": [
        "entity.other.attribute-name.id"
      ],
      "settings": {
        "foreground": "{editor_constant}"
      }
    },
    {
      "name": "CSS property values",
      "scope": [
        "support.constant.property-value",
        "support.constant.font-name",
        "support.constant.color",
        "support.constant.media"
      ],
      "settings": {
        "foreground": "{editor_constant}"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "markup.underline.link.image",
        "string.other.link",
        "constant.other.reference.link"
      ],
      "settings": {
        "foreground": "{editor_link}"
      }
    },
    {
      "name": "Markup headings",
      "scope": [
        "markup.heading",
        "markup.heading.setext",
        "entity.name.section",
        "punctuation.definition.heading"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "{editor_keyword}"
      }
    },
    {
      "name": "Markup bold",
      "scope": [
        "markup.bold",
        "punctuation.definition.bold"
      ],
      "settings": {
        "fontStyle": "bold",
        "foreground": "{editor_constant}"
      }
    },
    {
      "name": "Markup italic",
      "scope": [
        "markup.italic",
        "punctuation.definition.italic",
        "emphasis"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "{editor_type}"
      }
    },
    {
      "name": "Markup raw / code",
      "scope": [
        "markup.inline.raw",
        "markup.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "{editor_string}"
      }
    },
    {
      "name": "Markup quote",
      "scope": [
        "markup.quote",
        "beginning.punctuation.definition.quote"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "{editor_comment}"
      }
    },
    {
      "name": "Markup lists",
      "scope": [
        "markup.list",
        "punctuation.definition.list",
        "beginning.punctuation.definition.list"
      ],
      "settings": {
        "foreground": "{editor_punctuation}"
      }
    },
    {
      "name": "Diff / VCS inserted",
      "scope": [
        "markup.inserted",
        "markup.inserted.diff",
        "meta.diff.header.to-file",
        "punctuation.definition.inserted"
      ],
      "settings": {
        "foreground": "{editor_inserted}"
      }
    },
    {
      "name": "Diff / VCS deleted",
      "scope": [
        "markup.deleted",
        "markup.deleted.diff",
        "meta.diff.header.from-file",
        "punctuation.definition.deleted"
      ],
      "settings": {
        "foreground": "{editor_deleted}"
      }
    },
    {
      "name": "Diff / VCS changed",
      "scope": [
        "markup.changed",
        "markup.changed.diff",
        "meta.diff.header",
        "meta.diff.range",
        "punctuation.definition.changed"
      ],
      "settings": {
        "foreground": "{editor_modified}"
      }
    },
    {
      "name": "Diff ignored",
      "scope": [
        "markup.ignored",
        "markup.untracked"
      ],
      "settings": {
        "foreground": "{editor_ignored}"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid",
        "invalid.illegal",
        "invalid.broken",
        "invalid.unimplemented"
      ],
      "settings": {
        "foreground": "{editor_invalid}"
      }
    },
    {
      "name": "Deprecated",
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "fontStyle": "strikethrough",
        "foreground": "{editor_invalid}"
      }
    },
    {
      "name": "Debug console tokens",
      "scope": "token.info-token",
      "settings": {
        "foreground": "{editor_info}"
      }
    },
    {
      "scope": "token.warn-token",
      "settings": {
        "foreground": "{editor_warning}"
      }
    },
    {
      "scope": "token.error-token",
      "settings": {
        "foreground": "{editor_error}"
      }
    },
    {
      "scope": "token.debug-token",
      "settings": {
        "foreground": "{editor_comment}"
      }
    },
    {
      "name": "JSON property names",
      "scope": [
        "support.type.property-name.json",
        "source.json meta.structure.dictionary.json > string.quoted.json"
      ],
      "settings": {
        "foreground": "{editor_property}"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml",
        "punctuation.definition.block.sequence.item.yaml"
      ],
      "settings": {
        "foreground": "{editor_property}"
      }
    },
    {
      "name": "Python special members",
      "scope": [
        "support.type.python",
        "support.function.builtin.python"
      ],
      "settings": {
        "foreground": "{editor_function}"
      }
    },
    {
      "name": "Rust lifetimes",
      "scope": [
        "storage.modifier.lifetime.rust",
        "entity.name.lifetime.rust"
      ],
      "settings": {
        "foreground": "{editor_parameter}"
      }
    },
    {
      "name": "C/C++ preprocessor",
      "scope": [
        "keyword.control.directive.c",
        "keyword.control.directive.cpp",
        "entity.name.function.preprocessor.c",
        "entity.name.function.preprocessor.cpp"
      ],
      "settings": {
        "foreground": "{editor_decorator}"
      }
    },
    {
      "name": "Go package names",
      "scope": [
        "entity.name.package.go",
        "entity.name.import.go"
      ],
      "settings": {
        "foreground": "{editor_namespace}"
      }
    },
    {
      "name": "Makefile targets",
      "scope": [
        "entity.name.function.target.makefile",
        "meta.scope.prerequisites.makefile"
      ],
      "settings": {
        "foreground": "{editor_function}"
      }
    },
    {
      "name": "Shell variables",
      "scope": [
        "variable.other.normal.shell",
        "punctuation.definition.variable.shell"
      ],
      "settings": {
        "foreground": "{editor_variable}"
      }
    }
  ],
  "colors": {
