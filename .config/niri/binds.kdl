binds {
    // ### Applications
    Mod+Return hotkey-overlay-title="Terminal" { spawn "ghostty"; }
    Mod+E hotkey-overlay-title="File manager" { spawn "nautilus"; }
    Mod+D hotkey-overlay-title="Application launcher" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "launcher" "toggle"; }
    Mod+Shift+D hotkey-overlay-title="Run command" { spawn "rofi" "-show" "run"; }
    Mod+Tab hotkey-overlay-title="Window switcher" { spawn "rofi" "-show" "window"; }
    Mod+Equal hotkey-overlay-title="Calculator" { spawn-sh r#"rofi -show calc -modes calc -theme ~/.config/rofi/calc.rasi -no-show-match -no-sort -calc-command 'printf "%s" "{result}" | wl-copy'"#; }
    XF86Calculator { spawn-sh r#"rofi -show calc -modes calc -theme ~/.config/rofi/calc.rasi -no-show-match -no-sort -calc-command 'printf "%s" "{result}" | wl-copy'"#; }
    Mod+V hotkey-overlay-title="Clipboard history" { spawn-sh "cliphist list | rofi -dmenu -i -p clipboard | cliphist decode | wl-copy"; }
    Mod+W hotkey-overlay-title="Wallpaper picker" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "wallpapers" "toggle"; }
    Mod+Shift+V hotkey-overlay-title="VPN menu" { spawn-sh "~/.config/vpn/menu.sh"; }
    Mod+Ctrl+V hotkey-overlay-title="VPN toggle on/off" { spawn-sh "~/.config/vpn/vpnctl toggle"; }
    Mod+C hotkey-overlay-title="This cheatsheet" { show-hotkey-overlay; }

    // ### Session
    Mod+Q repeat=false hotkey-overlay-title="Close window" { close-window; }
    Mod+Shift+Q hotkey-overlay-title="Power menu" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "power" "toggle"; }
    Mod+Shift+C hotkey-overlay-title="Reload niri config" { spawn "niri" "msg" "action" "load-config-file"; }
    Mod+M hotkey-overlay-title="Exit niri" { quit; }
    Mod+Shift+Escape allow-inhibiting=false hotkey-overlay-title="Toggle shortcut inhibit" { toggle-keyboard-shortcuts-inhibit; }

    // ### Layout
    // Mod+Space is taken by the xkb layout toggle (see input.kdl)
    Mod+F hotkey-overlay-title="Fullscreen" { fullscreen-window; }
    Mod+Shift+F hotkey-overlay-title="Maximize column" { maximize-column; }
    Mod+Ctrl+F hotkey-overlay-title="Expand column to free width" { expand-column-to-available-width; }
    Mod+Shift+Space hotkey-overlay-title="Floating toggle" { toggle-window-floating; }
    Mod+Ctrl+Space hotkey-overlay-title="Focus tiling/floating" { switch-focus-between-floating-and-tiling; }
    Mod+T hotkey-overlay-title="Tabbed column" { toggle-column-tabbed-display; }
    Mod+X hotkey-overlay-title="Center column" { center-column; }
    Mod+O repeat=false hotkey-overlay-title="Overview" { toggle-overview; }

    // Stack windows into columns (niri's take on sway splits)
    Mod+BracketLeft hotkey-overlay-title="Consume/expel window left" { consume-or-expel-window-left; }
    Mod+BracketRight hotkey-overlay-title="Consume/expel window right" { consume-or-expel-window-right; }

    // ### Focus
    Mod+H { focus-column-or-monitor-left; }
    Mod+J { focus-window-or-monitor-down; }
    Mod+K { focus-window-or-monitor-up; }
    Mod+L { focus-column-or-monitor-right; }
    Mod+Left { focus-column-or-monitor-left; }
    Mod+Down { focus-window-or-monitor-down; }
    Mod+Up { focus-window-or-monitor-up; }
    Mod+Right { focus-column-or-monitor-right; }

    // ### Move
    Mod+Shift+H { move-column-left-or-to-monitor-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right-or-to-monitor-right; }
    Mod+Shift+Left { move-column-left-or-to-monitor-left; }
    Mod+Shift+Down { move-window-down; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }

    // ### Resize (sway's resize mode, without the mode)
    Mod+Ctrl+H { set-column-width "-5%"; }
    Mod+Ctrl+J { set-window-height "+5%"; }
    Mod+Ctrl+K { set-window-height "-5%"; }
    Mod+Ctrl+L { set-column-width "+5%"; }
    Mod+Ctrl+Left { set-column-width "-5%"; }
    Mod+Ctrl+Down { set-window-height "+5%"; }
    Mod+Ctrl+Up { set-window-height "-5%"; }
    Mod+Ctrl+Right { set-column-width "+5%"; }
    Mod+R hotkey-overlay-title="Cycle column width" { switch-preset-column-width; }
    Mod+Shift+R hotkey-overlay-title="Cycle window height" { switch-preset-window-height; }
    Mod+Ctrl+R hotkey-overlay-title="Reset window height" { reset-window-height; }

    // ### Workspaces
    // By name, not index: see the workspace declarations in config.kdl
    Mod+1 { focus-workspace "1"; }
    Mod+2 { focus-workspace "2"; }
    Mod+3 { focus-workspace "3"; }
    Mod+4 { focus-workspace "4"; }
    Mod+5 { focus-workspace "5"; }
    Mod+6 { focus-workspace "6"; }
    Mod+7 { focus-workspace "7"; }
    Mod+8 { focus-workspace "8"; }
    Mod+9 { focus-workspace "9"; }
    Mod+0 { focus-workspace "10"; }

    Mod+Shift+1 { move-window-to-workspace "1" focus=false; }
    Mod+Shift+2 { move-window-to-workspace "2" focus=false; }
    Mod+Shift+3 { move-window-to-workspace "3" focus=false; }
    Mod+Shift+4 { move-window-to-workspace "4" focus=false; }
    Mod+Shift+5 { move-window-to-workspace "5" focus=false; }
    Mod+Shift+6 { move-window-to-workspace "6" focus=false; }
    Mod+Shift+7 { move-window-to-workspace "7" focus=false; }
    Mod+Shift+8 { move-window-to-workspace "8" focus=false; }
    Mod+Shift+9 { move-window-to-workspace "9" focus=false; }
    Mod+Shift+0 { move-window-to-workspace "10" focus=false; }

    Mod+Page_Down { focus-workspace-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Shift+Page_Down { move-window-to-workspace-down focus=false; }
    Mod+Shift+Page_Up { move-window-to-workspace-up focus=false; }

    // Scroll with the mod held to cycle workspaces
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    // ### Screenshots -- saved to screenshot-path and copied to the clipboard
    Print hotkey-overlay-title="Screenshot: whole output" { screenshot-screen; }
    Shift+Print hotkey-overlay-title="Screenshot: region" { screenshot; }
    Ctrl+Print hotkey-overlay-title="Screenshot: focused window" { screenshot-window; }

    // ### Shell
    Mod+N hotkey-overlay-title="Notification centre" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "notifications" "toggle"; }
    Mod+Shift+N hotkey-overlay-title="Close notification centre" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "notifications" "close"; }
    Mod+Escape hotkey-overlay-title="Shell menu" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "menu" "toggle"; }
    Mod+Y hotkey-overlay-title="Calendar" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "calendar" "toggle"; }
    Mod+I hotkey-overlay-title="Network" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "network" "toggle"; }
    Mod+B hotkey-overlay-title="Bluetooth" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "bluetooth" "toggle"; }
    Mod+Shift+M hotkey-overlay-title="Media controls" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "media" "toggle"; }
    Mod+G hotkey-overlay-title="System stats" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "stats" "toggle"; }
    Mod+Period hotkey-overlay-title="Display settings" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "displays" "toggle"; }
    Mod+Comma hotkey-overlay-title="Shell settings" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "settings" "toggle"; }
    Mod+Ctrl+C hotkey-overlay-title="Shell IPC cheatsheet" { spawn "qs" "-c" "basedgoose-shell" "ipc" "call" "cheatsheet" "toggle"; }

    // ### Media keys
    XF86AudioRaiseVolume allow-when-locked=true { spawn "wpctl" "set-volume" "-l" "1" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }
    XF86AudioMicMute allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SOURCE@" "toggle"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-e4" "-n2" "set" "5%-"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioPause allow-when-locked=true { spawn "playerctl" "play-pause"; }
}
