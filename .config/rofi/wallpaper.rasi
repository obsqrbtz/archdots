// Grid variant of the base theme, used by sway/scripts/wallpaper.sh pick.
@import "~/.config/rofi/theme.rasi"

window {
    width:  66%;
    height: 72%;
}

listview {
    columns:      5;
    lines:        3;
    fixed-height: true;
    scrollbar:    false;
    spacing:      6px;
    padding:      8px;
}

element {
    orientation: vertical;
    spacing:     6px;
    padding:     6px;
    children:    [ element-icon, element-text ];
}

element-icon {
    // rofi only honours a single size value and fits the image inside that
    // square, so a 16:9 thumbnail renders 190x107 here.
    size:             190px;
    horizontal-align: 0.5;
}

element-text {
    horizontal-align: 0.5;
    vertical-align:   0.5;
}
