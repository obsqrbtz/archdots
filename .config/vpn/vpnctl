# ---------------------------------------------------------------- state ----


def load_json(path, default):
    try:
        with path.open() as fh:
            return json.load(fh)
    except (OSError, ValueError):
        return default


def save_json(path, data):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w") as fh:
        json.dump(data, fh, indent=2)
    tmp.replace(path)
    if path in (SUBS_FILE, STATE_FILE):
        path.chmod(0o600)


def load_subs():
    return load_json(SUBS_FILE, {"subs": []})


def load_state():
    state = load_json(STATE_FILE, {})
    state.setdefault("mode", "tun")
    state.setdefault("sub", None)
    state.setdefault("node", None)
    state.setdefault("routing", False)
    state.setdefault("autoupdate_hours", DEFAULT_AUTOUPDATE_HOURS)
    return state


def find_sub(subs, sub_id):
    for sub in subs["subs"]:
        if sub["id"] == sub_id:
            return sub
    return None


def find_node(sub, node_id):
    for node in sub.get("nodes", []):
        if node["id"] == node_id:
            return node
    return None


def active_node():
    """Return (sub, node) for the current selection, or (None, None)."""
    state = load_state()
    subs = load_subs()
    sub = find_sub(subs, state.get("sub"))
    if not sub:
        return None, None
    return sub, find_node(sub, state.get("node"))


# ------------------------------------------------------- link  parsing  ----


def b64decode(data):
    """Decode base64 that may be url-safe and/or missing its padding."""
    data = data.strip().replace("-", "+").replace("_", "/")
    data += "=" * (-len(data) % 4)
    return base64.b64decode(data)


def qs(url):
    return {k: v[0] for k, v in urllib.parse.parse_qs(url.query, keep_blank_values=True).items()}


def node_id(kind, server, port, secret):
    """Stable id: survives a subscription update that only renames the node."""
    raw = f"{kind}|{server}|{port}|{secret}".encode()
    return sha1(raw).hexdigest()[:10]


def truthy(value):
    return str(value).lower() in ("1", "true", "yes")


def build_tls(params, default_sni):
    security = (params.get("security") or "none").lower()
    if security not in ("tls", "reality", "xtls"):
        return None

    tls = {"enabled": True, "server_name": params.get("sni") or params.get("host") or default_sni}
    if truthy(params.get("allowInsecure", "")):
        tls["insecure"] = True
    if params.get("alpn"):
        tls["alpn"] = [a for a in params["alpn"].replace("%2C", ",").split(",") if a]

    fingerprint = params.get("fp") or ("chrome" if security == "reality" else "")
    if fingerprint:
        tls["utls"] = {"enabled": True, "fingerprint": fingerprint}

    if security == "reality":
        tls["reality"] = {
            "enabled": True,
            "public_key": params.get("pbk", ""),
            "short_id": params.get("sid", ""),
        }
    return tls


def build_transport(params):
    """Map a share-link transport onto sing-box. Returns (transport, error)."""
    net = (params.get("type") or params.get("net") or "tcp").lower()
    host = params.get("host", "")
    path = params.get("path", "/")

    if net in ("tcp", "raw", ""):
        if (params.get("headerType") or "").lower() == "http":
            return {"type": "http", "host": [h for h in host.split(",") if h], "path": path}, None
        return None, None

    if net == "ws":
        transport = {"type": "ws", "path": path}
        if host:
            transport["headers"] = {"Host": host}
        # v2ray smuggles early data into the path as ?ed=<size>
        if "?ed=" in path:
            base, _, ed = path.partition("?ed=")
            transport["path"] = base
            transport["max_early_data"] = int(re.sub(r"\D", "", ed) or 2048)
            transport["early_data_header_name"] = "Sec-WebSocket-Protocol"
        return transport, None

    if net == "grpc":
        return {"type": "grpc", "service_name": params.get("serviceName") or path.lstrip("/")}, None

    if net == "httpupgrade":
        transport = {"type": "httpupgrade", "path": path}
        if host:
            transport["host"] = host
        return transport, None

    if net in ("h2", "http"):
        return {"type": "http", "host": [h for h in host.split(",") if h], "path": path}, None

    if net == "quic":
        return {"type": "quic"}, None

    return None, f"transport {net} is not supported by sing-box"


def parse_vless(link):
    url = urllib.parse.urlparse(link)
    params = qs(url)
    server, port = url.hostname, url.port or 443
    name = urllib.parse.unquote(url.fragment) or f"{server}:{port}"

    out = {
        "type": "vless",
        "server": server,
        "server_port": port,
        "uuid": urllib.parse.unquote(url.username or ""),
        "packet_encoding": "xudp",
    }
    if params.get("flow"):
        out["flow"] = params["flow"]

    tls = build_tls(params, server)
    if tls:
        out["tls"] = tls
    transport, err = build_transport(params)
    if err:
        return None, name, err
    if transport:
        out["transport"] = transport

    return out, name, None


def parse_vmess(link):
    body = link[len("vmess://"):]
    try:
        raw = json.loads(b64decode(body))
    except (binascii.Error, ValueError, UnicodeDecodeError):
        return None, link[:40], "malformed vmess link"

    server = raw.get("add", "")
    port = int(raw.get("port") or 443)
    name = raw.get("ps") or f"{server}:{port}"

    out = {
        "type": "vmess",
        "server": server,
        "server_port": port,
        "uuid": raw.get("id", ""),
        "alter_id": int(raw.get("aid") or 0),
        "security": raw.get("scy") or "auto",
    }

    params = {
        "security": "tls" if str(raw.get("tls", "")).lower() in ("tls", "reality") else "none",
        "sni": raw.get("sni", ""),
        "host": raw.get("host", ""),
        "path": raw.get("path", "/"),
        "type": raw.get("net", "tcp"),
        "headerType": raw.get("type", ""),
        "alpn": raw.get("alpn", ""),
        "fp": raw.get("fp", ""),
        "serviceName": raw.get("path", ""),
    }
    tls = build_tls(params, server)
    if tls:
        out["tls"] = tls
    transport, err = build_transport(params)
    if err:
        return None, name, err
    if transport:
        out["transport"] = transport

    return out, name, None


def parse_trojan(link):
    url = urllib.parse.urlparse(link)
    params = qs(url)
    server, port = url.hostname, url.port or 443
    name = urllib.parse.unquote(url.fragment) or f"{server}:{port}"

    out = {
        "type": "trojan",
        "server": server,
        "server_port": port,
        "password": urllib.parse.unquote(url.username or ""),
    }
    # trojan is TLS by default, even when the link omits security=tls
    params.setdefault("security", "tls")
    tls = build_tls(params, server)
    if tls:
        out["tls"] = tls
    transport, err = build_transport(params)
    if err:
        return None, name, err
    if transport:
        out["transport"] = transport

    return out, name, None


def parse_ss(link):
    body = link[len("ss://"):]
    body, _, fragment = body.partition("#")
    name = urllib.parse.unquote(fragment)
    body, _, _query = body.partition("?")

    if "@" in body:
        # SIP002: ss://base64(method:pass)@host:port
        userinfo, _, hostport = body.rpartition("@")
        try:
            userinfo = b64decode(userinfo).decode()
        except (binascii.Error, UnicodeDecodeError):
            userinfo = urllib.parse.unquote(userinfo)
    else:
        # legacy: ss://base64(method:pass@host:port)
        try:
            decoded = b64decode(body).decode()
        except (binascii.Error, UnicodeDecodeError):
            return None, name or link[:40], "malformed ss link"
        userinfo, _, hostport = decoded.rpartition("@")

    method, _, password = userinfo.partition(":")
    host, _, port = hostport.rpartition(":")
    host = host.strip("[]")
    try:
        port = int(port)
    except ValueError:
        return None, name or link[:40], "malformed ss link"

    out = {
        "type": "shadowsocks",
        "server": host,
        "server_port": port,
        "method": method,
        "password": password,
    }
    return out, name or f"{host}:{port}", None


PARSERS = {
    "vless": parse_vless,
    "vmess": parse_vmess,
    "trojan": parse_trojan,
    "ss": parse_ss,
}


def parse_link(link):
    """Share link -> node dict. Unsupported nodes are kept, flagged with an error."""
    link = link.strip()
    scheme = link.split("://", 1)[0].lower() if "://" in link else ""
    parser = PARSERS.get(scheme)
    if not parser:
        return None

    try:
        out, name, err = parser(link)
    except Exception as exc:  # a single bad link must not sink the whole sub
        return {"id": node_id("bad", link, 0, ""), "name": link[:40], "type": scheme,
                "server": "", "port": 0, "error": str(exc), "outbound": None}

    if err or not out:
        return {"id": node_id(scheme, link, 0, ""), "name": name, "type": scheme,
                "server": "", "port": 0, "error": err or "unparsable", "outbound": None}

    secret = out.get("uuid") or out.get("password") or ""
    return {
        "id": node_id(out["type"], out["server"], out["server_port"], secret),
        "name": name,
        "type": out["type"],
        "server": out["server"],
        "port": out["server_port"],
        "error": None,
        "outbound": out,
    }


# ------------------------------------------------------- subscriptions  ----


def fetch_subscription(url):
    """Return (links, userinfo, title). Handles base64 and plaintext bodies."""
    req = urllib.request.Request(url, headers={"User-Agent": SUB_UA, "Accept": "*/*"})
    with urllib.request.urlopen(req, timeout=20) as resp:
        body = resp.read().decode("utf-8", "replace")
        headers = resp.headers

    userinfo = {}
    raw_userinfo = headers.get("subscription-userinfo", "")
    for part in raw_userinfo.split(";"):
        key, _, value = part.strip().partition("=")
        if key and value.strip().lstrip("-").isdigit():
            userinfo[key] = int(value)

    title = headers.get("profile-title", "")
    if title.startswith("base64:"):
        try:
            title = b64decode(title[7:]).decode("utf-8", "replace")
        except binascii.Error:
            title = ""

    text = body
    if "://" not in body:
        try:
            text = b64decode(body).decode("utf-8", "replace")
        except (binascii.Error, UnicodeDecodeError):
            raise RuntimeError("subscription body is neither base64 nor a link list")

    links = [line.strip() for line in text.splitlines() if "://" in line]
    if not links:
        raise RuntimeError("subscription contained no share links")
    return links, userinfo, title


def sub_update(sub):
    """Refresh one subscription in place. Returns a short status string."""
    links, userinfo, title = fetch_subscription(sub["url"])
    nodes = [node for node in (parse_link(link) for link in links) if node]
    if not nodes:
        raise RuntimeError("no usable nodes in subscription")

    sub["nodes"] = nodes
    sub["updated"] = int(time.time())
    sub["userinfo"] = userinfo
    if title and not sub.get("named"):
        sub["name"] = title
    bad = sum(1 for node in nodes if node["error"])
    return f"{len(nodes)} nodes" + (f", {bad} unsupported" if bad else "")


# -------------------------------------------------------- routing rules ----


class RulesError(RuntimeError):
    pass


def as_list(value):
    """Accept either a bare string or a list, so single-entry rules read well."""
    if value is None:
        return []
    return [value] if isinstance(value, str) else list(value)


def load_rules():
    """rules.json -> list of enabled, validated rules. A missing file means none."""
    if not RULES_FILE.exists():
        return []
    try:
        with RULES_FILE.open() as fh:
            raw = json.load(fh)
    except OSError as exc:
        raise RulesError(f"cannot read rules.json: {exc}")
    except ValueError as exc:
        raise RulesError(f"rules.json is not valid json: {exc}")

    rules = raw.get("rules") if isinstance(raw, dict) else raw
    if not isinstance(rules, list):
        raise RulesError('rules.json must hold a list of rules under "rules"')

    out = []
    for index, rule in enumerate(rules):
        if not isinstance(rule, dict):
            raise RulesError(f"rule {index + 1}: each rule must be an object")
        label = rule.get("name") or f"rule {index + 1}"

        unknown = set(rule) - RULE_FIELDS
        if unknown:
            raise RulesError(f"{label}: unknown field(s) {', '.join(sorted(unknown))}")
        if rule.get("action") not in RULE_ACTIONS:
            raise RulesError(f"{label}: action must be one of {', '.join(RULE_ACTIONS)}")
        if not any(rule.get(m) for m in RULE_MATCHERS):
            raise RulesError(f"{label}: needs at least one of {', '.join(RULE_MATCHERS)}")

        if rule.get("enabled", True):
            out.append(rule)
    return out


def has_ipv6_uplink():
    """True when the machine has real IPv6, i.e. outside our own tun device."""
    for line in run(["ip", "-6", "-o", "addr", "show", "scope", "global"]).stdout.splitlines():
        fields = line.split()
        if len(fields) > 1 and not fields[1].startswith(("tun", "sing")):
            return True
    return False


def compile_rules(rules):
    """Rules -> (route rules, dns rules, rule_set declarations).

    Each matcher family becomes its own route rule, because sing-box groups
    rule fields and AND-s the groups together. Measured against 1.13:
    domain/domain_suffix/ip_cidr/rule_set share one OR group, but `protocol`
    forms a group of its own -- so {domain, protocol} in one rule means
    "domain AND protocol", where this file means "either". Splitting keeps the
    file's OR reading intact and lines each route rule up with its dns mirror.
    """
    route, dns, sets = [], [], {}

    # The tun device advertises IPv6 whether or not the uplink has any. Traffic
    # we send direct leaves over the real interface, so an AAAA answer for a
    # direct destination is a connection that cannot complete -- Firefox tries
    # IPv6 first and gets an instant reset. Resolve those names A-only.
    # Proxied traffic is unaffected: the tunnel carries IPv6 perfectly well.
    direct_dns = {"action": "route", "server": "dns-local"}
    # Belt and braces for the same problem on the routing side: an ip/geoip
    # matcher can still be handed an IPv6 destination that never went through
    # our A-only resolver. Pinning direct rules to IPv4 lets those fall through
    # to the proxy, which reaches IPv6 fine, instead of failing outright.
    direct_only_v4 = {}
    if not has_ipv6_uplink():
        direct_dns["strategy"] = "ipv4_only"
        direct_only_v4 = {"ip_version": 4}

    for rule in rules:
        action = rule["action"]
        outcome = {"action": "reject"} if action == "block" else {"outbound": action}
        if action == "direct":
            outcome = {**direct_only_v4, **outcome}

        # -- domains -------------------------------------------------------
        exact, suffix = [], []
        for entry in as_list(rule.get("domain")):
            name = entry.strip().lower().lstrip("*")
            if name.startswith("."):
                suffix.append(name)
            elif name:
                # cover the apex and everything under it
                exact.append(name)
                suffix.append("." + name)
        if exact or suffix:
            match = {}
            if exact:
                match["domain"] = exact
            if suffix:
                match["domain_suffix"] = suffix
            route.append({**match, **outcome})
            # A domain routed direct must also resolve locally, or we hand it
            # answers from the far end of the tunnel and get the wrong CDN.
            if action == "direct":
                dns.append({**match, **direct_dns})
            elif action == "block":
                dns.append({**match, "action": "reject"})

        # -- literal addresses ---------------------------------------------
        cidrs = []
        for entry in as_list(rule.get("ip")):
            entry = entry.strip()
            if "/" not in entry:
                entry += "/128" if ":" in entry else "/32"
            cidrs.append(entry)
        if cidrs:
            # no dns mirror: the address is only known after resolving
            route.append({"ip_cidr": cidrs, **outcome})

        # -- geosite / geoip categories ------------------------------------
        site_tags, ip_tags = [], []
        for name in as_list(rule.get("category")):
            tag = f"geosite-{name}"
            sets[tag] = GEOSITE_URL.format(name)
            site_tags.append(tag)
        for name in as_list(rule.get("geoip")):
            tag = f"geoip-{name}"
            sets[tag] = GEOIP_URL.format(name)
            ip_tags.append(tag)
        if site_tags or ip_tags:
            route.append({"rule_set": site_tags + ip_tags, **outcome})
            if site_tags and action == "direct":
                dns.append({"rule_set": site_tags, **direct_dns})
            elif site_tags and action == "block":
                dns.append({"rule_set": site_tags, "action": "reject"})

        # -- sniffed protocols (bittorrent, quic, ssh, ...) -----------------
        protocols = as_list(rule.get("protocol"))
        if protocols:
            route.append({"protocol": protocols, **outcome})

    declarations = [
        {
            "type": "remote",
            "tag": tag,
            "format": "binary",
            "url": url,
            # fetched off-tunnel: at startup the proxy is not up yet
            "download_detour": "direct",
            "update_interval": "7d",
        }
        for tag, url in sorted(sets.items())
    ]
    return route, dns, declarations


def url_status(url):
    """True/False when we know, None when we could not tell (offline, etc.)."""
    req = urllib.request.Request(url, method="HEAD", headers={"User-Agent": "vpnctl"})
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return 200 <= resp.status < 300
    except urllib.error.HTTPError as exc:
        return False if exc.code == 404 else None
    except Exception:
        return None


def suggest_names(name, kind):
    """Best-effort "did you mean" pulled from the upstream listing."""
    repo = "sing-geosite" if kind == "geosite" else "sing-geoip"
    url = f"https://api.github.com/repos/SagerNet/{repo}/git/trees/rule-set"
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "vpnctl"})
        with urllib.request.urlopen(req, timeout=10) as resp:
            tree = json.load(resp).get("tree", [])
    except Exception:
        return []
    prefix, names = f"{kind}-", []
    for entry in tree:
        path = entry.get("path", "")
        if path.startswith(prefix) and path.endswith(".srs"):
            names.append(path[len(prefix):-4])

    # Rank by how the upstream repo actually names things: umbrella lists are
    # "category-<name>", so a bare "ru" means "category-ru" far more often than
    # it means "ruby", "rust" or "t2-ru".
    def rank(candidate):
        if candidate == name:
            tier = 0
        elif candidate == f"category-{name}":
            tier = 1
        elif name in candidate.split("-"):
            tier = 2
        else:
            tier = 3
        return (tier, len(candidate))

    return sorted((n for n in names if name in n), key=rank)[:6]


def verify_rule_sets(declarations):
    """Reject a rule-set that does not exist upstream.

    sing-box treats a 404 here as fatal and systemd restarts it forever, so the
    tunnel would just never come up. Catching it now turns a silent crash loop
    into one clear message. Network failures are not treated as proof of
    absence -- being offline must not stop you connecting.
    """
    cache = load_json(RULESET_CACHE, {})
    checked = False

    for decl in declarations:
        tag = decl["tag"]
        if cache.get(tag):
            continue
        exists = url_status(decl["url"])
        if exists is None:
            continue
        if not exists:
            kind, _, name = tag.partition("-")
            field = "category" if kind == "geosite" else "geoip"
            message = f'{field} "{name}" does not exist upstream ({decl["url"]})'
            hint = suggest_names(name, kind)
            if hint:
                message += "\ndid you mean: " + ", ".join(hint)
            die(message)
        cache[tag] = int(time.time())
        checked = True

    if checked:
        save_json(RULESET_CACHE, cache)


def routing_rules(enabled):
    """Compiled rules, or nothing at all if the file is broken.

    Failing closed sends everything through the tunnel, which is the safe way
    to be wrong -- the alternative leaks traffic the rules meant to divert.
    """
    if not enabled:
        return [], [], []
    try:
        return compile_rules(load_rules())
    except RulesError as exc:
        warn(f"routing rules ignored -- {exc}")
        return [], [], []


# ---------------------------------------------------------- config gen ----


def gen_config(node, mode, routing=None):
    outbound = dict(node["outbound"])
    outbound["tag"] = "proxy"

    inbounds = [{
        "type": "mixed",
        "tag": "mixed-in",
        "listen": "127.0.0.1",
        "listen_port": MIXED_PORT,
    }]
    if mode == "tun":
        inbounds.insert(0, {
            "type": "tun",
            "tag": "tun-in",
            "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
            "auto_route": True,
            "strict_route": True,
            "stack": "mixed",
        })

    if routing is None:
        routing = load_state()["routing"]
    route_rules, dns_rules, rule_sets = routing_rules(routing)

    # Scaffolding first, then whatever the rules file asked for, then `final`.
    rules = [{"action": "sniff"}]
    if mode == "tun":
        rules.append({"protocol": "dns", "action": "hijack-dns"})
    rules.append({"ip_is_private": True, "outbound": "direct"})
    rules.extend(route_rules)

    dns = {
        "servers": [
            {"type": "udp", "tag": "dns-remote", "server": "1.1.1.1", "detour": "proxy"},
            {"type": "local", "tag": "dns-local"},
        ],
        "final": "dns-remote",
        "strategy": "prefer_ipv4",
        "independent_cache": True,
    }
    if dns_rules:
        dns["rules"] = dns_rules

    route = {
        "rules": rules,
        "final": "proxy",
        "auto_detect_interface": True,
        # resolve the proxy server's own hostname off-tunnel, or we deadlock
        "default_domain_resolver": {"server": "dns-local"},
    }
    if rule_sets:
        route["rule_set"] = rule_sets

    config = {
        "log": {"level": "warn", "timestamp": True},
        "dns": dns,
        "inbounds": inbounds,
        "outbounds": [outbound, {"type": "direct", "tag": "direct"}],
        "route": route,
    }
    if rule_sets:
        # without a cache the .srs files are re-downloaded on every start;
        # the path is relative to the -D working dir each service already sets
        config["experimental"] = {"cache_file": {"enabled": True, "path": "cache.db"}}
    return config


def config_path(mode):
    return TUN_CONFIG if mode == "tun" else PROXY_CONFIG


def write_config(node, mode):
    # A subscription refresh can move a node onto a transport we cannot build,
    # while keeping the id we are pointed at.
    if node["error"] or not node.get("outbound"):
        die(f"node '{node['name']}' is unusable: {node['error'] or 'no outbound'}")

    path = config_path(mode)
    config = gen_config(node, mode)
    verify_rule_sets(config.get("route", {}).get("rule_set", []))
    changed = load_json(path, None) != config

    try:
        path.parent.mkdir(parents=True, exist_ok=True)
        save_json(path, config)
        # holds the node credentials -- keep it off world-readable. /etc/vpn is
        # setgid sing-box, so the service still gets at it through the group.
        path.chmod(0o640 if mode == "tun" else 0o600)
    except OSError as exc:
        if mode == "tun":
            die(f"cannot write {path}: {exc}\nrun ~/.config/vpn/install.sh once to set tun mode up")
        die(f"cannot write {path}: {exc}")

    check = run(["sing-box", "check", "-c", str(path)])
    if check.returncode != 0:
        die(f"sing-box rejected the generated config:\n{check.stderr.strip()}")
    return path, changed


# ------------------------------------------------------ service control ----


def run(cmd, **kwargs):
    return subprocess.run(cmd, capture_output=True, text=True, **kwargs)


def unit_cmd(mode, *args):
    if mode == "tun":
        return ["systemctl", *args, TUN_UNIT]
    return ["systemctl", "--user", *args, PROXY_UNIT]


def unit_state(mode):
    """systemd's word for it: active, activating, failed, inactive..."""
    return run(unit_cmd(mode, "is-active")).stdout.strip()


def is_active(mode):
    return unit_state(mode) == "active"


def running_mode():
    for mode in ("tun", "proxy"):
        if is_active(mode):
            return mode
    return None


def broken_mode():
    """A mode whose service is failing rather than simply switched off.

    Without this a crash-looping tunnel is indistinguishable from one the user
    turned off, which is how a bad rule-set once hid behind a plain "vpn off".
    """
    for mode in ("tun", "proxy"):
        if unit_state(mode) in ("failed", "activating", "auto-restart"):
            return mode
    return None


def last_error(mode):
    unit = TUN_UNIT if mode == "tun" else PROXY_UNIT
    cmd = ["journalctl", "-n", "40", "--no-pager", "-o", "cat"]
    cmd += ["-u", unit] if mode == "tun" else ["--user", "-u", unit]
    for line in reversed(run(cmd).stdout.splitlines()):
        if "FATAL" in line or "ERROR" in line:
            # strip the level tag and any ansi colouring journalctl kept
            return re.sub(r"\x1b\[[0-9;]*m", "", line).split("] ", 1)[-1].strip()
    return ""


def notify_waybar():
    run(["pkill", "-RTMIN+9", "waybar"])


def do_up(quiet=False):
    state = load_state()
    sub, node = active_node()
    if not node:
        die("no node selected -- pick one from the menu first")
    if node["error"]:
        die(f"node '{node['name']}' is unusable: {node['error']}")

    mode = state["mode"]
    _path, changed = write_config(node, mode)

    other = "proxy" if mode == "tun" else "tun"
    if is_active(other):
        run(unit_cmd(other, "stop"))

    if is_active(mode) and not changed:
        # nothing to apply -- don't drop live connections for a no-op
        if not quiet:
            print(f"already connected: {node['name']} ({mode})")
        return

    result = run(unit_cmd(mode, "restart" if is_active(mode) else "start"))
    notify_waybar()
    if result.returncode != 0:
        die(f"failed to start {mode} service:\n{result.stderr.strip()}")
    if not quiet:
        print(f"connected: {node['name']} ({mode})")


def do_down(quiet=False):
    for mode in ("tun", "proxy"):
        if is_active(mode):
            run(unit_cmd(mode, "stop"))
    notify_waybar()
    if not quiet:
        print("disconnected")


# -------------------------------------------------------------- pinging ----


def tcp_latency(host, port, timeout=3.0, attempts=2):
    best = None
    for _ in range(attempts):
        start = time.monotonic()
        try:
            with socket.create_connection((host, port), timeout=timeout):
                pass
        except OSError:
            continue
        elapsed = int((time.monotonic() - start) * 1000)
        best = elapsed if best is None else min(best, elapsed)
    return best


def ping_nodes(nodes):
    """TCP-handshake latency for every node, measured in parallel."""
    targets = [node for node in nodes if node["server"] and not node["error"]]
    results = {}
    if targets:
        with futures.ThreadPoolExecutor(max_workers=min(32, len(targets))) as pool:
            jobs = {pool.submit(tcp_latency, n["server"], n["port"]): n["id"] for n in targets}
            for job in futures.as_completed(jobs):
                results[jobs[job]] = job.result()

    cache = load_json(PING_FILE, {})
    now = int(time.time())
    for nid, latency in results.items():
        cache[nid] = {"ms": latency, "at": now}
    save_json(PING_FILE, cache)
    return results


def ping_cache():
    return load_json(PING_FILE, {})


def check_tunnel():
    """Prove the tunnel actually carries traffic, not just that the unit is up."""
    mode = running_mode()
    if not mode:
        return None, "not connected"

    cmd = ["curl", "-s", "-o", "/dev/null", "-w", "%{http_code} %{time_total}",
           "--max-time", "8", "https://www.gstatic.com/generate_204"]
    if mode == "proxy":
        cmd[1:1] = ["--proxy", f"socks5h://127.0.0.1:{MIXED_PORT}"]

    result = run(cmd)
    if result.returncode != 0:
        return None, "no response through the tunnel"
    code, _, seconds = result.stdout.partition(" ")
    if code not in ("204", "200"):
        return None, f"unexpected response {code}"
    return int(float(seconds) * 1000), "ok"


# ----------------------------------------------------------- formatting ----


def ago(timestamp):
    if not timestamp:
        return "never"
    delta = int(time.time()) - int(timestamp)
    if delta < 90:
        return "just now"
    if delta < 5400:
        return f"{delta // 60}m ago"
    if delta < 172800:
        return f"{delta // 3600}h ago"
    return f"{delta // 86400}d ago"


def human_bytes(value):
    step = float(value)
    for unit in ("B", "K", "M", "G", "T"):
        if step < 1024 or unit == "T":
            return f"{step:.0f}{unit}" if unit == "B" else f"{step:.1f}{unit}"
        step /= 1024
    return f"{step:.1f}T"


def latency_label(node, cache):
    if node["error"]:
        return "n/a"
    entry = cache.get(node["id"])
    if not entry:
        return "-"
    return f"{entry['ms']}ms" if entry["ms"] is not None else "down"


def sub_traffic(sub):
    info = sub.get("userinfo") or {}
    if not info.get("total"):
        return ""
    used = info.get("upload", 0) + info.get("download", 0)
    text = f"{human_bytes(used)}/{human_bytes(info['total'])}"
    if info.get("expire"):
        days = (info["expire"] - int(time.time())) // 86400
        text += f", {days}d left" if days >= 0 else ", expired"
    return text


def warn(message):
    print(message, file=sys.stderr)
    if not sys.stderr.isatty():
        subprocess.run(["notify-send", "-a", "vpn", "-t", "6000", "vpn", message],
                       capture_output=True)


def die(message):
    print(message, file=sys.stderr)
    # Launched from a keybind or a waybar click there is no terminal to read,
    # so route the failure to dunst instead of dropping it.
    if not sys.stderr.isatty():
        subprocess.run(["notify-send", "-a", "vpn", "-u", "critical", "-t", "6000",
                        "vpn", message], capture_output=True)
    sys.exit(1)


# ---------------------------------------------------------- subcommands ----


def cmd_sub_add(args):
    subs = load_subs()
    url = args.url.strip()
    if not url.startswith(("http://", "https://")):
        die("subscription must be an http(s) url")
    if any(s["url"] == url for s in subs["subs"]):
        die("that subscription is already imported")

    sub = {
        "id": sha1(url.encode()).hexdigest()[:8],
        "name": args.name or "",
        "named": bool(args.name),
        "url": url,
        "updated": 0,
        "nodes": [],
    }
    status = sub_update(sub)
    if not sub["name"]:
        sub["name"] = urllib.parse.urlparse(url).hostname or sub["id"]
    subs["subs"].append(sub)
    save_json(SUBS_FILE, subs)

    state = load_state()
    if not state.get("sub"):
        state["sub"] = sub["id"]
        save_json(STATE_FILE, state)
    print(f"added {sub['name']}: {status}")


def cmd_sub_list(args):
    subs = load_subs()
    if args.json:
        print(json.dumps(subs["subs"], indent=2))
        return

    state = load_state()
    width = max((len(s["name"]) for s in subs["subs"]), default=10)
    for sub in subs["subs"]:
        marker = "*" if sub["id"] == state.get("sub") else " "
        parts = [f"{len(sub.get('nodes', []))} nodes", ago(sub["updated"])]
        traffic = sub_traffic(sub)
        if traffic:
            parts.append(traffic)
        if args.rofi:
            print(f"{marker} {sub['name'].ljust(width)}   {'  ·  '.join(parts)}")
        else:
            print(f"{marker} {sub['id']}  {sub['name'].ljust(width)}  {'  '.join(parts)}")


def cmd_sub_remove(args):
    subs = load_subs()
    sub = find_sub(subs, args.id)
    if not sub:
        die(f"no subscription with id {args.id}")
    subs["subs"] = [s for s in subs["subs"] if s["id"] != args.id]
    save_json(SUBS_FILE, subs)

    state = load_state()
    if state.get("sub") == args.id:
        state["sub"] = subs["subs"][0]["id"] if subs["subs"] else None
        state["node"] = None
        save_json(STATE_FILE, state)
    print(f"removed {sub['name']}")


def cmd_sub_rename(args):
    subs = load_subs()
    sub = find_sub(subs, args.id)
    if not sub:
        die(f"no subscription with id {args.id}")
    sub["name"] = args.name
    sub["named"] = True
    save_json(SUBS_FILE, subs)
    print(f"renamed to {args.name}")


def cmd_sub_update(args):
    subs = load_subs()
    targets = subs["subs"] if args.all or not args.id else [find_sub(subs, args.id)]
    targets = [t for t in targets if t]
    if not targets:
        die("nothing to update")

    if args.stale_only:
        cutoff = time.time() - load_state()["autoupdate_hours"] * 3600
        targets = [t for t in targets if t["updated"] < cutoff]
        if not targets:
            return

    failures = 0
    for sub in targets:
        try:
            status = sub_update(sub)
            if not args.quiet:
                print(f"{sub['name']}: {status}")
        except Exception as exc:
            failures += 1
            print(f"{sub['name']}: {exc}", file=sys.stderr)
    save_json(SUBS_FILE, subs)

    # a refresh may have dropped the node we were pointed at
    state = load_state()
    sub, node = active_node()
    if sub and not node and sub.get("nodes"):
        state["node"] = None
        save_json(STATE_FILE, state)
    if failures:
        sys.exit(1)


def cmd_nodes(args):
    subs = load_subs()
    state = load_state()
    sub = find_sub(subs, args.sub or state.get("sub"))
    if not sub:
        die("no subscription selected")

    nodes = sub.get("nodes", [])
    if args.ping:
        ping_nodes(nodes)
    cache = ping_cache()

    if args.json:
        print(json.dumps([dict(n, latency=cache.get(n["id"], {}).get("ms")) for n in nodes], indent=2))
        return

    name_w = max((len(n["name"]) for n in nodes), default=10)
    type_w = max((len(n["type"]) for n in nodes), default=6)
    for node in nodes:
        marker = "*" if node["id"] == state.get("node") else " "
        row = (f"{marker} {node['name'].ljust(name_w)}  {node['type'].ljust(type_w)}  "
               f"{latency_label(node, cache).rjust(6)}")
        if args.rofi:
            print(row + (f"   ({node['error']})" if node["error"] else ""))
        else:
            print(f"{node['id']} {row}")


def cmd_use(args):
    subs = load_subs()
    state = load_state()
    sub = find_sub(subs, args.sub) if args.sub else find_sub(subs, state.get("sub"))
    if not sub:
        die("no such subscription")
    node = find_node(sub, args.node)
    if not node:
        die("no such node")
    if node["error"]:
        die(f"node '{node['name']}' is unusable: {node['error']}")

    state["sub"] = sub["id"]
    state["node"] = node["id"]
    save_json(STATE_FILE, state)

    if running_mode() or args.connect:
        do_up(quiet=True)
        print(f"connected: {node['name']}")
    else:
        notify_waybar()
        print(f"selected: {node['name']}")


def cmd_up(args):
    do_up()


def cmd_down(args):
    do_down()


def cmd_toggle(args):
    if running_mode():
        do_down()
    else:
        do_up()


def cmd_mode(args):
    state = load_state()
    if not args.mode:
        print(state["mode"])
        return
    if args.mode not in ("tun", "proxy"):
        die("mode must be tun or proxy")

    was_up = running_mode()
    if was_up:
        do_down(quiet=True)
    state["mode"] = args.mode
    save_json(STATE_FILE, state)
    if was_up:
        do_up(quiet=True)
    notify_waybar()
    print(f"mode: {args.mode}")


def cmd_status(args):
    state = load_state()
    sub, node = active_node()
    mode = running_mode()
    broken = None if mode else broken_mode()
    info = {
        "connected": bool(mode),
        "broken": bool(broken),
        "error": last_error(broken) if broken else "",
        "mode": mode or state["mode"],
        "configured_mode": state["mode"],
        "routing": state["routing"],
        "sub": sub["name"] if sub else None,
        "node": node["name"] if node else None,
        "node_type": node["type"] if node else None,
        "server": f"{node['server']}:{node['port']}" if node else None,
        "traffic": sub_traffic(sub) if sub else "",
        "updated": ago(sub["updated"]) if sub else "never",
    }
    if args.json:
        print(json.dumps(info, indent=2))
        return

    if args.line:
        # one-line summary for the rofi -mesg header
        head = f"connected · {mode}" if mode else ("FAILING" if broken else "off")
        parts = [head, f"node: {info['node'] or 'none'}", f"sub: {info['sub'] or 'none'}"]
        if info["routing"]:
            parts.append("routing: on")
        if info["traffic"]:
            parts.append(info["traffic"])
        print("   ".join(parts))
        return

    if mode:
        print(f"connected  {info['node']} ({info['sub']})  {mode}")
    elif broken:
        print(f"failing  {broken} service is not staying up\n{info['error']}")
    else:
        print(f"off  selected: {info['node'] or 'none'}")


def cmd_waybar(args):
    state = load_state()
    sub, node = active_node()
    mode = running_mode()

    if mode:
        name = node["name"] if node else "on"
        text = f"vpn {name[:18]}"
        cls = "connected"
        tooltip = [f"connected via {mode}"]
        if node:
            tooltip.append(f"{node['name']}  ({node['type']})")
            tooltip.append(f"{node['server']}:{node['port']}")
            entry = ping_cache().get(node["id"], {})
            if entry.get("ms") is not None:
                tooltip.append(f"tcp {entry['ms']}ms")
        if mode == "proxy":
            tooltip.append(f"socks/http on 127.0.0.1:{MIXED_PORT}")
        tooltip.append(f"routing rules: {'on' if state['routing'] else 'off'}")
    elif broken_mode():
        broken = broken_mode()
        text = "vpn error"
        cls = "error"
        tooltip = [f"the {broken} service is not staying up"]
        reason = last_error(broken)
        if reason:
            tooltip.append(reason)
        tooltip.append("")
        scope = "" if broken == "tun" else "--user "
        tooltip.append(f"logs: journalctl {scope}-u vpn-{broken}.service")
    else:
        text = "vpn off"
        cls = "disconnected"
        tooltip = ["disconnected"]
        tooltip.append(f"selected: {node['name'] if node else 'none'}  ({state['mode']} mode)")

    if sub:
        tooltip.append(f"sub: {sub['name']}  updated {ago(sub['updated'])}")
        traffic = sub_traffic(sub)
        if traffic:
            tooltip.append(f"traffic: {traffic}")
    tooltip.append("")
    tooltip.append("click: menu   right-click: toggle")

    print(json.dumps({
        "text": text,
        "class": cls,
        "alt": cls,
        "tooltip": "\n".join(tooltip),
    }))


def cmd_ping(args):
    subs = load_subs()
    state = load_state()
    sub = find_sub(subs, args.sub or state.get("sub"))
    if not sub:
        die("no subscription selected")
    results = ping_nodes(sub.get("nodes", []))
    alive = sum(1 for value in results.values() if value is not None)
    print(f"{alive}/{len(results)} reachable")


def cmd_check(args):
    latency, message = check_tunnel()
    if latency is None:
        die(message)
    print(f"ok  {latency}ms through the tunnel")


def cmd_autoupdate(args):
    state = load_state()
    if args.hours is None:
        print(state["autoupdate_hours"])
        return
    state["autoupdate_hours"] = max(1, args.hours)
    save_json(STATE_FILE, state)
    print(f"auto-update every {state['autoupdate_hours']}h")


def cmd_gen(args):
    state = load_state()
    _sub, node = active_node()
    if not node:
        die("no node selected")
    path, _changed = write_config(node, state["mode"])
    print(path)


def cmd_routing(args):
    state = load_state()

    if args.list:
        try:
            rules = load_rules()
        except RulesError as exc:
            die(str(exc))
        if not rules:
            print(f"no rules in {RULES_FILE}")
            return
        width = max(len(r.get("name") or "") for r in rules)
        for rule in rules:
            matchers = ", ".join(
                f"{m}={len(as_list(rule[m]))}" for m in RULE_MATCHERS if rule.get(m)
            )
            print(f"{(rule.get('name') or '-').ljust(width)}  {rule['action'].ljust(6)}  {matchers}")
        return

    if not args.action:
        print("on" if state["routing"] else "off")
        return

    if args.action == "toggle":
        want = not state["routing"]
    elif args.action in ("on", "off"):
        want = args.action == "on"
    else:
        die("routing takes on, off or toggle")

    # Validate loudly here -- gen_config only warns and falls back, which is
    # right when connecting but useless when you are asking for rules on purpose.
    if want:
        try:
            rules = load_rules()
        except RulesError as exc:
            die(str(exc))
        if not rules:
            warn(f"routing is on but {RULES_FILE} has no enabled rules")

    state["routing"] = want
    save_json(STATE_FILE, state)

    if running_mode():
        do_up(quiet=True)
    notify_waybar()
    print(f"routing: {'on' if want else 'off'}")


# ----------------------------------------------------------------- cli ----


def main():
    parser = argparse.ArgumentParser(prog="vpnctl", description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("sub", help="manage subscriptions")
    subsub = sp.add_subparsers(dest="subcmd", required=True)

    p = subsub.add_parser("add"); p.add_argument("url"); p.add_argument("--name")
    p.set_defaults(func=cmd_sub_add)
    p = subsub.add_parser("list")
    p.add_argument("--json", action="store_true")
    p.add_argument("--rofi", action="store_true")
    p.set_defaults(func=cmd_sub_list)
    p = subsub.add_parser("remove"); p.add_argument("id"); p.set_defaults(func=cmd_sub_remove)
    p = subsub.add_parser("rename"); p.add_argument("id"); p.add_argument("name")
    p.set_defaults(func=cmd_sub_rename)
    p = subsub.add_parser("update")
    p.add_argument("id", nargs="?")
    p.add_argument("--all", action="store_true")
    p.add_argument("--stale-only", action="store_true")
    p.add_argument("--quiet", action="store_true")
    p.set_defaults(func=cmd_sub_update)

    p = sub.add_parser("nodes", help="list nodes in a subscription")
    p.add_argument("sub", nargs="?")
    p.add_argument("--json", action="store_true")
    p.add_argument("--rofi", action="store_true")
    p.add_argument("--ping", action="store_true")
    p.set_defaults(func=cmd_nodes)

    p = sub.add_parser("use", help="select a node")
    p.add_argument("node")
    p.add_argument("--sub")
    p.add_argument("--connect", action="store_true")
    p.set_defaults(func=cmd_use)

    for name, func, help_text in (
        ("up", cmd_up, "connect"),
        ("down", cmd_down, "disconnect"),
        ("toggle", cmd_toggle, "toggle the tunnel"),
        ("check", cmd_check, "verify traffic flows through the tunnel"),
        ("waybar", cmd_waybar, "emit waybar json"),
        ("gen", cmd_gen, "regenerate the sing-box config"),
    ):
        sub.add_parser(name, help=help_text).set_defaults(func=func)

    p = sub.add_parser("status", help="show current state")
    p.add_argument("--json", action="store_true")
    p.add_argument("--line", action="store_true")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("mode", help="tun (system-wide) or proxy (socks/http only)")
    p.add_argument("mode", nargs="?")
    p.set_defaults(func=cmd_mode)

    p = sub.add_parser("routing", help="apply the rules in rules.json, or don't")
    p.add_argument("action", nargs="?", choices=["on", "off", "toggle"])
    p.add_argument("--list", action="store_true", help="show the rules that would apply")
    p.set_defaults(func=cmd_routing)

    p = sub.add_parser("ping", help="measure tcp latency to every node")
    p.add_argument("sub", nargs="?")
    p.set_defaults(func=cmd_ping)

    p = sub.add_parser("autoupdate", help="hours between automatic refreshes")
    p.add_argument("hours", nargs="?", type=int)
    p.set_defaults(func=cmd_autoupdate)

    args = parser.parse_args()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    try:
        args.func(args)
    except KeyboardInterrupt:
        sys.exit(130)
    except urllib.error.URLError as exc:
        die(f"network error: {exc.reason}")
    except RuntimeError as exc:
        die(str(exc))


if __name__ == "__main__":
    main()
